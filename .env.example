# Copy this file to .env and fill in real values. .env is gitignored.

# From the Guava dashboard: API Keys -> "Create API Key"
GUAVA_API_KEY=

# From the Guava dashboard: Phone Numbers (the number already provisioned on your account)
GUAVA_AGENT_NUMBER=

# Mock policy API (added in Build Order Step 2) - leave as-is for local dev
MOCK_API_URL=http://localhost:8000
